include LICENSE CREDITS.md DUAL-LICENSING.md SECURITY.md CONTRIBUTING.md README.md CHANGELOG.md RELEASE_NOTES.md omus.spec
include PKGBUILD .SRCINFO
recursive-include .github *.yml *.yaml
recursive-include .clusterfuzzlite *
recursive-include docs *.md
recursive-include debian *
recursive-include packaging *
recursive-include requirements *.in *.txt
recursive-include fuzz *
recursive-include scripts *.py *.sh
recursive-include assets/icons *.png
recursive-include src/mouse_control/udev *.rules
global-exclude *.py[cod]
global-exclude __pycache__
